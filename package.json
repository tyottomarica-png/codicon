{
  "name": "codicon",
  "version": "0.2.0",
  "private": true,
  "description": "A controller-first cockpit for Claude Code and OpenAI Codex on Linux and macOS",
  "desktopName": "Codicon",
  "main": "electron/main.cjs",
  "author": "kloysova and Codicon contributors",
  "license": "MIT",
  "homepage": "https://github.com/kloysova/codicon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kloysova/codicon.git"
  },
  "bugs": {
    "url": "https://github.com/kloysova/codicon/issues"
  },
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "smoke:codex": "node scripts/codex-smoke.cjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.224",
    "gamepad-node": "^1.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "dev.codicon.app",
    "productName": "Codicon",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@kmamal/sdl/**",
      "**/node_modules/@anthropic-ai/**"
    ],
    "artifactName": "Codicon-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Codicon uses the microphone only while Push to Talk is held to send your spoken instruction to Codex."
      }
    },
    "linux": {
      "category": "Development",
      "syncDesktopName": true,
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
